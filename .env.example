# ===== データベース接続 =====
# 開発（SQLite）。本番（PostgreSQL）は DATABASE_PROVIDER=postgresql を設定し、
# DATABASE_URL を接続文字列に差し替えます（provider はビルド時に自動切替）。
DATABASE_URL="file:./dev.db"
# 本番（PostgreSQL）の例：
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dhp_database?schema=public"

# datasource provider の切替: 未設定/sqlite=開発, postgresql=本番
# DATABASE_PROVIDER="postgresql"

# ===== セッション署名鍵 =====
# 32文字以上のランダム文字列。本番では必ず変更してください。
# 生成例: openssl rand -base64 48
AUTH_SECRET="change-me-please-use-a-long-random-secret-string"
